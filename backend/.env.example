# ── Quill backend configuration ──────────────────────────────
# Copy to .env and fill in. The app boots in demo mode (no external
# AI calls) when GEMINI_API_KEY is absent — everything still works.

PORT=3001
NODE_ENV=development

# PostgreSQL (docker compose provides this URL)
DATABASE_URL="postgresql://quill:quill@localhost:5432/quill?schema=public"

# Redis for BullMQ
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="http://localhost:3000"

# Uploads
UPLOAD_DIR="./uploads"

# Optional: Google Gemini (AI Studio key). If empty → demo mode.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_EMBED_MODEL="gemini-embedding-001"

# Pinecone (required). Dense cosine index, 768-dim Gemini embeddings.
PINECONE_API_KEY=""
PINECONE_INDEX="quill"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"

# Metrics basic auth (optional)
METRICS_USERNAME=""
METRICS_PASSWORD=""

# Virus scanning (ClamAV) - optional
# CLAMAV_BINARY_PATH="/usr/bin/clamscan"
# CLAMAV_SOCKET="/var/run/clamav/clamd.ctl"
# CLAMAV_HOST="localhost"
# CLAMAV_PORT=3310

# Cloudflare R2 Object Storage (S3-compatible) - optional
# If not configured, falls back to local filesystem (UPLOAD_DIR)
# R2_ACCOUNT_ID="your-account-id"
# R2_ACCESS_KEY_ID="your-access-key-id"
# R2_SECRET_ACCESS_KEY="your-secret-access-key"
# R2_BUCKET_NAME="quill"
# Keep the bucket private. Objects are read through authenticated API routes (presigned GET internally).

