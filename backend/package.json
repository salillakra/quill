{
  "name": "quill-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "worker": "bun run src/worker.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:migrate": "bunx prisma migrate dev",
    "db:seed": "bunx prisma db seed",
    "db:reset": "bunx prisma migrate reset --force && bun run db:seed",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "sample": "bun run scripts/sample-pdf.ts"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@google/genai": "^2.8.0",
    "@pinecone-database/pinecone": "^8.2.0",
    "@prisma/client": "~6.19.3",
    "@socket.io/bun-engine": "^0.1.1",
    "bullmq": "^5.78.0",
    "clamscan": "^2.4.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "ioredis": "^5.11.0",
    "jose": "^6.2.3",
    "katex": "^0.17.0",
    "marked": "^18.0.4",
    "playwright": "^1.60.0",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "prisma": "~6.19.3",
    "typescript": "^5.9.2"
  }
}
